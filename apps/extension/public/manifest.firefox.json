{
  "manifest_version": 3,
  "name": "CODEFORT Guard",
  "version": "0.2.0",
  "description": "Real-time AI Pull Request Security Intelligence & Automated Remediation Copilot powered by BARQAI.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "webNavigation",
    "notifications"
  ],
  "host_permissions": [
    "https://github.com/*",
    "https://codefort-web.vercel.app/*",
    "https://codefort-lilac.vercel.app/*",
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://github.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CODEFORT Guard // BARQAI",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "codefort-guard@codefort.sec",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
